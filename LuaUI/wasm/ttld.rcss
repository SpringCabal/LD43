/* RmlUi has no built-in HTML stylesheet: without these every element would lay
   out inline, which collapsed the intro's control list and story column into a
   single ragged run of text.  For the same reason every absolutely positioned
   block below carries an explicit width: RmlUi shrink-wraps rather than
   stretching a box between `left` and `right`. */
div {
  display: block;
}

span {
  display: inline;
}

/* An explicit width as well as `display: block`: without it RmlUi shrink-wraps
   the paragraph to its longest word, which stacked the intro story one word per
   line. */
p {
  display: block;
  width: 100%;
  margin-bottom: 10dp;
}

body {
  position: absolute;
  left: 0dp;
  right: 0dp;
  top: 0dp;
  bottom: 0dp;
  width: auto;
  height: auto;
  font-family: FreeSans;
  color: #ffffff;
  font-size: 20dp;
  pointer-events: none;
}

body * {
  pointer-events: none;
}

#health-panel {
  position: absolute;
  left: 35%;
  top: 94%;
  width: 17%;
  height: 5%;
}

#health-heart {
  position: absolute;
  left: 5%;
  top: 0dp;
  bottom: 0dp;
  width: 8%;
  height: auto;
}

#health-bar {
  position: absolute;
  left: 0dp;
  top: 0dp;
  background-color: #141414c0;
  border: 1dp #000000;
  width: 100%;
  height: 100%;
}

#health-fill {
  position: absolute;
  left: 0dp;
  top: 0dp;
  bottom: 0dp;
  width: 100%;
  background-color: #00bf00;
  height: auto;
}

#health-caption {
  position: absolute;
  left: 0dp;
  top: 0dp;
  text-align: center;
  font-size: 18dp;
  width: 100%;
}

#target-panel {
  position: absolute;
  left: 35%;
  top: 1%;
  width: 17%;
  height: 7%;
}

#target-bar {
  position: absolute;
  left: 0dp;
  top: 0dp;
  height: 48%;
  background-color: #141414c0;
  border: 1dp #000000;
  width: 100%;
}

#target-fill {
  position: absolute;
  left: 0dp;
  top: 0dp;
  bottom: 0dp;
  width: 100%;
  background-color: #00bf00;
  height: auto;
}

#target-panel.enemy #target-fill {
  background-color: #bf0000;
}

#target-caption {
  position: absolute;
  left: 0dp;
  top: 0dp;
  text-align: center;
  font-size: 16dp;
  width: 100%;
}

#target-name {
  position: absolute;
  left: 0dp;
  top: 52%;
  text-align: center;
  font-size: 16dp;
  background-color: #ff000080;
  width: 100%;
  height: 48%;
}

#target-panel.enemy #target-name {
  background-color: #bf0000c0;
}

#bindings {
  position: absolute;
  left: 10dp;
  bottom: 10dp;
  width: 340dp;
}

.bind {
  height: 24dp;
  font-size: 20dp;
}

.key {
  color: #ff0aff;
}

#intro, #endgame {
  position: absolute;
  left: 0dp;
  right: 0dp;
  top: 0dp;
  bottom: 0dp;
  background-color: #00000090;
  pointer-events: auto;
  width: auto;
  height: auto;
}

/* Fixed size, centred, so the children's dp offsets and widths lay out the same
   way at every resolution. */
#intro-window {
  position: absolute;
  left: 50%;
  top: 50%;
  width: 1100dp;
  height: 680dp;
  margin-left: -550dp;
  margin-top: -340dp;
  background-color: #101018e8;
  border: 2dp #40404a;
  padding: 8dp;
  pointer-events: auto;
}

#intro-title {
  position: absolute;
  left: 0dp;
  top: 16dp;
  text-align: center;
  font-size: 50dp;
  color: #ff0000;
  width: 100%;
}

#intro-controls {
  position: absolute;
  left: 60dp;
  top: 110dp;
  width: 440dp;
}

.controls-title {
  font-size: 32dp;
  margin-bottom: 12dp;
}

.control {
  font-size: 20dp;
  margin-top: 10dp;
}

.control-desc {
  font-size: 16dp;
  margin-left: 60dp;
  color: #c8c8c8;
}

/* The story owns the whole right column; the goals sit under the controls on
   the left so neither has to scroll. */
#intro-story {
  position: absolute;
  left: 540dp;
  width: 524dp;
  top: 100dp;
  height: 430dp;
  font-size: 20dp;
}

#intro-goals {
  position: absolute;
  left: 60dp;
  width: 440dp;
  top: 540dp;
  height: 120dp;
  font-size: 20dp;
}

.sacrifice {
  color: #ffbebe;
}

#intro-play {
  position: absolute;
  left: 540dp;
  bottom: 16dp;
  width: 260dp;
  height: 70dp;
  font-size: 36dp;
}

#intro-exit {
  position: absolute;
  left: 820dp;
  bottom: 16dp;
  width: 260dp;
  height: 70dp;
  font-size: 36dp;
}

#endgame-window {
  position: absolute;
  left: 50%;
  top: 20%;
  width: 400dp;
  height: 400dp;
  margin-left: -200dp;
  background-color: #101018e8;
  border: 2dp #40404a;
  padding: 8dp;
  pointer-events: auto;
}

#endgame-title {
  position: absolute;
  left: 10dp;
  top: 25dp;
  text-align: center;
  /* Long enough to wrap in the 400dp window at the old 50dp. */
  font-size: 38dp;
  color: #ff0000;
  width: 364dp;
}

#endgame-title.victory {
  top: 5dp;
  color: #00ff00;
}

#endgame-line-one {
  position: absolute;
  left: 20dp;
  top: 150dp;
  font-size: 20dp;
  width: 344dp;
}

#endgame-line-two {
  position: absolute;
  left: 20dp;
  top: 200dp;
  font-size: 20dp;
  width: 344dp;
}

#endgame-thanks {
  position: absolute;
  left: 20dp;
  top: 260dp;
  font-size: 20dp;
  width: 344dp;
}

#endgame-restart {
  position: absolute;
  left: 10dp;
  bottom: 5dp;
  width: 175dp;
  height: 80dp;
  font-size: 24dp;
}

#endgame-exit {
  position: absolute;
  right: 10dp;
  bottom: 5dp;
  width: 175dp;
  height: 80dp;
  font-size: 24dp;
}

.button {
  background-color: #2a2a38;
  border: 2dp #5a5a6a;
  text-align: center;
  pointer-events: auto;
}

.button:hover {
  background-color: #3a3a4c;
  border-color: #8a8aa0;
}
