set shell := ["bash", "-cu"]

fmt:
    cargo fmt --all

clippy:
    cargo clippy --workspace --target wasm32-unknown-unknown --release -- -D warnings

build: fmt clippy
    cargo build --workspace --target wasm32-unknown-unknown --release

copy: build
    cp target/wasm32-unknown-unknown/release/ttld_rules_wasm.wasm ../LuaRules/wasm/ttld-rules.wasm
    cp target/wasm32-unknown-unknown/release/ttld_ui_wasm.wasm ../LuaUI/wasm/ttld-ui.wasm
