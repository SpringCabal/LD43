set shell := ["bash", "-cu"]

fmt:
    cargo fmt --all

clippy:
    cargo clippy --workspace --target wasm32-unknown-unknown --release -- -D warnings

build: fmt clippy
    cargo build --workspace --target wasm32-unknown-unknown --release

copy: build
    cp "${CARGO_TARGET_DIR:-target}/wasm32-unknown-unknown/release/ttld_rules_wasm.wasm" ../LuaRules/wasm/ttld-rules.wasm
    cp "${CARGO_TARGET_DIR:-target}/wasm32-unknown-unknown/release/ttld_rules_unsynced_wasm.wasm" ../LuaRules/wasm/ttld-rules-unsynced.wasm
    cp "${CARGO_TARGET_DIR:-target}/wasm32-unknown-unknown/release/ttld_ui_wasm.wasm" ../LuaUI/wasm/ttld-ui.wasm
